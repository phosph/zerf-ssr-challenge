{
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ],
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": true,
    "module": "esnext",
    "isolatedModules": true,
    "strict": true,
    "target": "es2022",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": [
      "ES2024"
    ],
    "resolveJsonModule": true,
    "declaration": true,
    "verbatimModuleSyntax": true
  }
}
