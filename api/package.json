{
  "name": "zerf-ssr-challenge-api",
  "version": "1.0.0",
  "description": "",
  "main": "main.ts",
  "type": "module",
  "scripts": {
    "test": "IS_TEST=true mocha --require ts-node/register --require source-map-support/register --full-trace --bail 'test/**/*.test.ts'",
    "test:coverage": "c8 pnpm run test",
    "db-migrate": "export $(cat .env | grep \"^[^#]\" | xargs) && graphile-migrate migrate",
    "dev": "node main.ts",
    "graphile-migrate": "export $(cat .env | grep \"^[^#]\" | xargs) && graphile-migrate",
    "build": "esbuild ./main.ts --outbase=. --bundle --minify --sourcemap --sources-content=false --outfile=dist/main.cjs --platform=node --format=cjs"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22",
    "@types/pg": "^8.11.6",
    "@types/sinon": "^17.0.4",
    "@types/ws": "^8.18.1",
    "c8": "^10.1.3",
    "esbuild": "^0.25.10",
    "eslint": "^9",
    "fastify-cli": "^7.4.0",
    "mocha": "^11.7.2",
    "sinon": "^18.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/env": "^5.0.2",
    "@fastify/postgres": "^6.0.2",
    "@fastify/schedule": "^6.0.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/websocket": "^11.2.0",
    "ajv": "^8.17.1",
    "common": "workspace:*",
    "date-fns": "^4.1.0",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.0.1",
    "graphile-migrate": "^1.4.1",
    "pg": "^8.16.3",
    "sino": "^0.0.3",
    "toad-scheduler": "^3.1.0",
    "ws": "^8.18.3"
  }
}
